{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadOnlyLookups",
            "Effect": "Allow",
            "Action": [
                "ec2:DescribeInstances",
                "ec2:DescribeSecurityGroups",
                "ec2:DescribeSubnets",
                "ssm:DescribeInstanceInformation"
            ],
            "Resource": "*"
        },
        {
            "Sid": "PublicAmiParameter",
            "Effect": "Allow",
            "Action": "ssm:GetParameter",
            "Resource": "arn:aws:ssm:*::parameter/aws/service/ami-amazon-linux-latest/*"
        },
        {
            "Sid": "LaunchOnlyTaggedBastion",
            "Effect": "Allow",
            "Action": "ec2:RunInstances",
            "Resource": "arn:aws:ec2:*:*:instance/*",
            "Condition": {
                "StringLike": { "aws:RequestTag/Name": "nequi-*-db-bastion" }
            }
        },
        {
            "Sid": "LaunchSupportingResources",
            "Effect": "Allow",
            "Action": "ec2:RunInstances",
            "Resource": [
                "arn:aws:ec2:*::image/*",
                "arn:aws:ec2:*:*:subnet/*",
                "arn:aws:ec2:*:*:security-group/*",
                "arn:aws:ec2:*:*:network-interface/*",
                "arn:aws:ec2:*:*:volume/*"
            ]
        },
        {
            "Sid": "TagOnLaunchOnly",
            "Effect": "Allow",
            "Action": "ec2:CreateTags",
            "Resource": "arn:aws:ec2:*:*:instance/*",
            "Condition": {
                "StringEquals": { "ec2:CreateAction": "RunInstances" }
            }
        },
        {
            "Sid": "TerminateOnlyTaggedBastion",
            "Effect": "Allow",
            "Action": "ec2:TerminateInstances",
            "Resource": "arn:aws:ec2:*:*:instance/*",
            "Condition": {
                "StringLike": { "ec2:ResourceTag/Name": "nequi-*-db-bastion" }
            }
        },
        {
            "Sid": "PassOnlyTheBastionRoleToEc2",
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "arn:aws:iam::*:role/nequi-db-bastion",
            "Condition": {
                "StringEquals": { "iam:PassedToService": "ec2.amazonaws.com" }
            }
        },
        {
            "Sid": "SessionToTaggedBastionOnly",
            "Effect": "Allow",
            "Action": "ssm:StartSession",
            "Resource": [
                "arn:aws:ec2:*:*:instance/*",
                "arn:aws:ssm:*:*:document/AWS-StartPortForwardingSessionToRemoteHost"
            ],
            "Condition": {
                "StringLike": { "ssm:resourceTag/Name": "nequi-*-db-bastion" }
            }
        },
        {
            "Sid": "StartPortForwardingDocument",
            "Effect": "Allow",
            "Action": "ssm:StartSession",
            "Resource": "arn:aws:ssm:*:*:document/AWS-StartPortForwardingSessionToRemoteHost"
        },
        {
            "Sid": "CloseOwnSessions",
            "Effect": "Allow",
            "Action": "ssm:TerminateSession",
            "Resource": "arn:aws:ssm:*:*:session/${aws:username}-*"
        },
        {
            "Sid": "ReadDbSecretsOnly",
            "Effect": "Allow",
            "Action": "secretsmanager:GetSecretValue",
            "Resource": "arn:aws:secretsmanager:*:*:secret:nequi-*/db-*"
        }
    ]
}
